<Window x:Class="LocalAITaskManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LocalAITaskManager.App.Converters"
        xmlns:vm="clr-namespace:LocalAITaskManager.App.ViewModels"
        Title="Local AI Task Manager"
        Width="920" Height="740"
        MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

  <Window.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
    <converters:BooleanToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <!-- Title & Header -->
      <RowDefinition Height="Auto" />
      <!-- Warnings / Notices -->
      <RowDefinition Height="Auto" />
      <!-- Hardware Overview Cards -->
      <RowDefinition Height="Auto" />
      <!-- Processes Table Header & DataGrid -->
      <RowDefinition Height="*" />
      <!-- Selected Process Details -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Local AI Task Manager" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
      <TextBlock Text="Windows &amp; NVIDIA Real-Time Hardware Telemetry" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
    </StackPanel>

    <!-- Warnings / Errors -->
    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <!-- GPU Warning Banner -->
      <Border Background="#2D2415" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding HasGpuWarning, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding GpuWarningMessage}" Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap" />
      </Border>

      <!-- PDH Warning Banner -->
      <Border Background="#2D2415" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
              Visibility="{Binding HasProcessWarning, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding ProcessWarningMessage}" Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <!-- Hardware Cards -->
    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="280" />
      </Grid.ColumnDefinitions>

      <!-- GPU Telemetry Card -->
      <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <ItemsControl ItemsSource="{Binding Gpus}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GpuDeviceViewModel}">
              <StackPanel Margin="0,0,0,12">
                <!-- GPU Name & Driver -->
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding DriverVersion, StringFormat='Driver {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" DockPanel.Dock="Right" />
                </DockPanel>

                <!-- VRAM Bar & Ratio -->
                <DockPanel LastChildFill="False" Margin="0,0,0,4">
                  <TextBlock Text="VRAM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding VramText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Right" />
                </DockPanel>
                <ProgressBar Style="{StaticResource FlatProgressBarStyle}" Value="{Binding VramPercent}" Maximum="100" Margin="0,0,0,12" />

                <!-- GPU Metrics Row -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="UTILIZATION" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding GpuUtilizationText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Column="1">
                    <TextBlock Text="TEMPERATURE" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding TemperatureText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock Text="POWER DRAW" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding PowerText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- System RAM Card -->
      <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
          <TextBlock Text="SYSTEM RAM" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
          <DockPanel LastChildFill="False" Margin="0,0,0,4">
            <TextBlock Text="Physical Memory" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding SystemRamText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Right" />
          </DockPanel>
          <ProgressBar Style="{StaticResource FlatProgressBarStyle}" Value="{Binding SystemRamPercent}" Maximum="100" Margin="0,0,0,16" />

          <TextBlock Text="Process VRAM Attribution" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2" />
          <TextBlock Text="Queried via Windows KMD PDH counters aggregated by PID." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- GPU Processes Table -->
    <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
      <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="8,4,8,8">
          <TextBlock Text="GPU PROCESSES" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
          <TextBlock Text="{Binding Processes.Count, StringFormat='{}{0} active'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="160" />
            <DataGridTextColumn Header="Runtime" Binding="{Binding RuntimeText}" Width="100">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="Model" Binding="{Binding ModelText}" Width="220">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="VRAM" Binding="{Binding VramText}" Width="90">
              <DataGridTextColumn.HeaderStyle>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                  <Setter Property="ToolTip" Value="Local GPU memory reported by Windows WDDM. Does not necessarily sum to global device VRAM." />
                </Style>
              </DataGridTextColumn.HeaderStyle>
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="RAM" Binding="{Binding RamText}" Width="90">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="70">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!-- Selected Process Inspector -->
    <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
      <Grid>
        <!-- When Process Selected -->
        <StackPanel Visibility="{Binding HasSelectedProcess, Converter={StaticResource BoolToVis}}">
          <DockPanel LastChildFill="False" Margin="0,0,0,4">
            <TextBlock Text="{Binding SelectedProcess.ProcessName, StringFormat='Selected: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
            <TextBlock Text="{Binding SelectedProcess.Pid, StringFormat='PID {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" />
          </DockPanel>

          <!-- AI WORKLOAD Card (Visible when AI process is detected) -->
          <Border Background="#161616" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,6"
                  Visibility="{Binding SelectedProcess.IsAiWorkload, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,6">
                <TextBlock Text="AI WORKLOAD" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding SelectedProcess.AiRuntimeConfidenceText, StringFormat='Confidence: {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" DockPanel.Dock="Right" />
              </DockPanel>

              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Runtime" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiRuntimeText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Model" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiModelNameText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Quantization" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiQuantizationText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                  <TextBlock Text="Parameters" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiParameterSizeText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>

              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Context configured" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiConfiguredContextText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Runtime-reported VRAM" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.AiRuntimeReportedVramText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Windows local GPU memory" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.LocalUsageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>

              <TextBlock Text="Detection evidence:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,2" />
              <ItemsControl ItemsSource="{Binding SelectedProcess.AiEvidence}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,1,0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <StackPanel Margin="0,2,0,4">
            <TextBlock Text="Executable:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Text="{Binding SelectedProcess.ExecutablePath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="11" Padding="0" Cursor="Arrow" SelectionBrush="{StaticResource SelectionBrush}" />
          </StackPanel>

          <StackPanel Margin="0,2,0,6">
            <TextBlock Text="Command line:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBox Text="{Binding SelectedProcess.CommandLine, Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="11" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto" Padding="0" Cursor="Arrow" SelectionBrush="{StaticResource SelectionBrush}" />
          </StackPanel>

          <!-- GPU MEMORY — WINDOWS WDDM -->
          <Border Background="#161616" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="GPU MEMORY — WINDOWS WDDM" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="Local usage" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.LocalUsageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="Non-local usage" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.NonLocalUsageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                  <TextBlock Text="Total committed" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.TotalCommittedText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                  <TextBlock Text="Dedicated usage" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.DedicatedUsageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                  <TextBlock Text="Shared usage" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding SelectedProcess.SharedUsageText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Placeholder when nothing selected -->
        <TextBlock Text="Select a process above to inspect executable path and command line."
                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                   VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding HasSelectedProcess, Converter={StaticResource InvBoolToVis}}" />
      </Grid>
    </Border>
  </Grid>
</Window>
